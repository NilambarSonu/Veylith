{
  "name": "veylith",
  "version": "0.1.0",
  "private": true,
  "description": "An AI-native security gateway for MCP agents, powered by Meta Muse",
  "author": "Nilambar Behera",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "veylith-stdio": "./bin/veylith-stdio.js"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run packages/ apps/",
    "test:integration": "vitest run tests/integration",
    "test:all": "vitest run",
    "smoke:meta": "tsx scripts/meta-smoke-test.ts",
    "benchmark": "tsx scripts/benchmark-suite.ts",
    "benchmark:phase-2d": "tsx scripts/benchmark-phase-2d.ts",
    "validate:live": "tsx scripts/live-validation-runner.ts",
    "eval:holdout": "vitest run tests/integration/holdout-evaluation.test.ts",
    "stdio": "tsx apps/stdio-adapter/src/index.ts",
    "demo:client": "tsx scripts/demo-real-client.ts",
    "dashboard": "pnpm --filter @veylith/research-dashboard start",
    "dashboard:dev": "pnpm --filter @veylith/research-dashboard dev",
    "dev": "echo 'See docs/development/local-setup.md for multi-process dev instructions'",
    "clean": "pnpm -r run clean && rm -rf node_modules",
    "security:eval": "pnpm build && tsx scripts/security-lab/index.ts development",
    "security:eval:holdout": "pnpm build && tsx scripts/security-lab/index.ts holdout",
    "security:eval:report": "tsx scripts/security-lab/index.ts report",
    "security:eval:live": "tsx scripts/security-lab/live.ts",
    "security:eval:reliability": "node --expose-gc --import tsx scripts/security-lab/reliability.ts",
    "security:eval:typecheck": "tsc -p scripts/security-lab/tsconfig.json --noEmit",
    "security:remediation:lifecycle": "node --expose-gc --import tsx scripts/security-remediation/lifecycle.ts",
    "security:remediation:typecheck": "tsc -p scripts/security-remediation/tsconfig.json --noEmit",
    "security:remediation:test": "vitest run tests/integration/phase-2f-*.test.ts packages/policy-engine/tests/phase-2f-boundary.test.ts apps/gateway/tests/local-boundary.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@types/node": "^22.13.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "prettier": "^3.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.2.0",
    "zod": "^4.2.0"
  }
}
